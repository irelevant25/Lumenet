{
  // The server listens on every network card of this PC. This PC can always use the desk.
  // Another device in the same network (a phone, a tablet) only while LAN is switched on in the
  // page, and only with the LAN password; while LAN is off its connections are refused.
  // "http://localhost:5080" here keeps the desk on this PC for good.
  "Urls": "http://*:5080",

  // Who may reach the server, besides the LAN rule above. The hub has no login of its own, so
  // these two settings are what keeps other web sites out:
  //   AllowedHosts            the names by which the server lets itself be called. This PC's
  //                           own addresses and computer name are always allowed on top.
  //   Server:AllowedOrigins   the web pages that may use the hub: scheme, host and port. The
  //                           page this server hands out itself is always allowed on top.
  // If "Urls" gets another port, Server:AllowedOrigins needs the new address as well.
  "AllowedHosts": "localhost;127.0.0.1",
  "Server": {
    "AllowedOrigins": [
      "http://localhost:5080",
      "http://127.0.0.1:5080",
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },

  "Box": {
    "Host": "192.168.7.1",
    "Port": 7000
  },

  // Empty: the folder "Lumenet" in My Documents.
  "Projects": {
    "Folder": ""
  },

  // The built UI that the server hands out, to other devices above all. Empty: "wwwroot" next
  // to the program. run.mjs builds the UI and gives its folder on the command line.
  "Ui": {
    "Folder": ""
  },

  // Where the LAN password is kept. Empty: Lumenet\lan-password.txt in the local application
  // data of this user (%LOCALAPPDATA%). Delete the file for a new password.
  "Lan": {
    "PasswordFile": ""
  },

  // Where the work that is not saved yet is kept, every few seconds, until the project is saved;
  // the desk brings it back when it starts. Empty: Lumenet\autosave.json in the local
  // application data of this user (%LOCALAPPDATA%).
  "Autosave": {
    "File": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
