<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The version, shared with Lumenet.exe: the program reads it from its assembly. -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DmxBox.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxBox\DmxBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serial ports of the DMX USB interfaces (Enttec DMX USB Pro and compatible), on
         Windows, Linux and macOS. Lumenet.exe takes the same package. -->
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
    <!-- MIDI controllers, on Windows and macOS (DryWetMIDI has no devices on Linux): MidiPorts.cs
         keeps it behind an interface of the desk's own. Lumenet.exe takes the same package. -->
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests work on the desk, the project files and the box link directly. -->
    <InternalsVisibleTo Include="DmxBox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example projects of the repository: the Load window lists them (Projects:Examples). An
         example with sounds has their files in a folder beside it ("8 Sounds sounds"). -->
    <None Include="..\..\examples\*.json" Link="examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\**\*.mp3;..\..\examples\**\*.wav" Link="examples\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
