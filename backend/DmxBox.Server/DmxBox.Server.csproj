<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The version, shared with Lumenet.exe: the program reads it from its assembly. -->
  <Import Project="..\Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DmxBox.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxBox\DmxBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests work on the desk, the project files and the box link directly. -->
    <InternalsVisibleTo Include="DmxBox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example projects of the repository: the Load window lists them (Projects:Examples). -->
    <None Include="..\..\examples\*.json" Link="examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
