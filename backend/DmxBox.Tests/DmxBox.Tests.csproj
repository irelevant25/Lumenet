<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example project of the repository, for ExampleProjectTests, and the example show
         file of a theatre console, for ExampleShowFileTests -->
    <None Include="..\..\examples\Example show.json" Link="examples\Example show.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\examples\Example theatre show.asc" Link="examples\Example theatre show.asc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxBox\DmxBox.csproj" />
    <ProjectReference Include="..\DmxBox.Server\DmxBox.Server.csproj" />
  </ItemGroup>

</Project>
