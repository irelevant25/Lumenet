	(text "IN asks for 5 V (R1, R2). OUT offers 5 V (R5, R6) and is switched on only when the RP2040 sees a box on CC1 or CC2 (R7, R8)."
		(exclude_from_sim no)
		(at 17.78 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d5492c0b-41be-5854-866c-65579aa8bfa3")
	)
	(text "Q1 lets IN's 5 V through unless a charger is on POWER; D1 lets POWER's through. Q2 and Q3 back to back: no current comes back from OUT."
		(exclude_from_sim no)
		(at 17.78 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85604c03-d38f-5973-9703-9602955d833b")
	)
	(text "The hub has its own 3.3 V regulator, load capacitors and 1.5k pull-up; RESET, PSELF and OVCUR stay open (self powered, no over-current input)."
		(exclude_from_sim no)
		(at 17.78 190.5 0)
		(effects
