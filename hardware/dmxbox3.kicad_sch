	(text "dmxbox 3: a USB network adapter for the Lumenet desk (and any Art-Net program) with one DMX output with RDM, MIDI IN and OUT,"
		(exclude_from_sim no)
		(at 30.48 116.84 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "c2c618cf-688e-5392-a9fd-c4dbeb71530d")
	)
	(text "and a USB hub so that boxes can be chained: computer -> box 1 -> box 2 -> ... (up to 5 on one port)."
		(exclude_from_sim no)
		(at 30.48 121.92 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "facd267a-ae71-5492-b48e-8c7fc3f7bed2")
	)
	(text "JLCPCB solders every part (LCSC numbers in the LCSC field). You make the cables from the pin headers J4,"
		(exclude_from_sim no)
		(at 30.48 132.08 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left bottom)
		)
		(uuid "9b18d12e-35dc-5576-9521-5b8973953656")
	)
	(text "J5 and J6 to the XLR and DIN sockets in the box wall."
