<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The simulators of the DMX devices the desk plays, started by sim.cmd at the root of the
    repository: the dmxboxes (the firmware's own code, built in firmware/sim) and an Art-Net node,
    an sACN receiver and an Enttec DMX USB Pro. A running simulator is a device plugged into this
    PC: the desk finds it by itself (DmxBox.SimulatorRegistry).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DmxBox.Sim</RootNamespace>
    <AssemblyName>dmxbox-sim</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxBox\DmxBox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests play the simulators in their own process. -->
    <InternalsVisibleTo Include="DmxBox.Tests" />
  </ItemGroup>

</Project>
