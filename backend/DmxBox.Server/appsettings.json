{
  "Urls": "http://localhost:5080",

  // Who may reach the server: as it stands, only a browser on this PC. The hub has no login,
  // so these two settings are all that keeps other web sites and other devices out.
  //   AllowedHosts            the names by which the server lets itself be called
  //   Server:AllowedOrigins   the web pages that may use the hub: scheme, host and port
  // If the desk is ever opened from another device, BOTH have to be widened on purpose, to
  // exactly the addresses that are needed ("Urls" then has to listen on more than localhost).
  // If "Urls" gets another port, Server:AllowedOrigins needs the new address as well.
  "AllowedHosts": "localhost;127.0.0.1",
  "Server": {
    "AllowedOrigins": [
      "http://localhost:5080",
      "http://127.0.0.1:5080",
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },

  "Box": {
    "Host": "192.168.7.1",
    "Port": 7000
  },

  // Empty: the folder "Lumenet" in My Documents.
  "Projects": {
    "Folder": ""
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
