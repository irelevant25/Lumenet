<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The namespaces of the desk program and of the tests' own folders, known in every test file. -->
    <Using Include="DmxBox.Server" />
    <Using Include="DmxBox.Server.Api" />
    <Using Include="DmxBox.Server.Boxes" />
    <Using Include="DmxBox.Server.Core" />
    <Using Include="DmxBox.Server.Effects" />
    <Using Include="DmxBox.Server.Import" />
    <Using Include="DmxBox.Server.Lan" />
    <Using Include="DmxBox.Server.Midi" />
    <Using Include="DmxBox.Server.Osc" />
    <Using Include="DmxBox.Server.Outputs" />
    <Using Include="DmxBox.Server.Projects" />
    <Using Include="DmxBox.Server.Sequences" />
    <Using Include="DmxBox.Server.Sounds" />
    <Using Include="DmxBox.Server.Stack" />
    <Using Include="DmxBox.Server.Stage" />
    <Using Include="DmxBox.Server.Update" />
    <Using Include="DmxBox.Tests.Api" />
    <Using Include="DmxBox.Tests.Boxes" />
    <Using Include="DmxBox.Tests.Client" />
    <Using Include="DmxBox.Tests.Core" />
    <Using Include="DmxBox.Tests.Effects" />
    <Using Include="DmxBox.Tests.Import" />
    <Using Include="DmxBox.Tests.Lan" />
    <Using Include="DmxBox.Tests.Midi" />
    <Using Include="DmxBox.Tests.Outputs" />
    <Using Include="DmxBox.Tests.Projects" />
    <Using Include="DmxBox.Tests.Sequences" />
    <Using Include="DmxBox.Tests.Sounds" />
    <Using Include="DmxBox.Tests.Stack" />
    <Using Include="DmxBox.Tests.Stage" />
    <Using Include="DmxBox.Tests.Support" />
  </ItemGroup>

  <ItemGroup>
    <!-- The example show file of a theatre console, for ExampleShowFileTests. The example
         projects, for ExampleProjectTests, come with DmxBox.Server. -->
    <None Include="..\..\examples\Example theatre show.asc" Link="examples\Example theatre show.asc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DmxBox\DmxBox.csproj" />
    <ProjectReference Include="..\DmxBox.Server\DmxBox.Server.csproj" />
    <ProjectReference Include="..\DmxBox.Sim\DmxBox.Sim.csproj" />
  </ItemGroup>

</Project>
